# Ignorar cachés de Python (backend)
__pycache__/
*.pyc
*.pyo
*.pyd
backend/.mypy_cache/
backend/.pytest_cache/
backend/.venv/

key.json
# Ignorar cachés de Node/Vite/Vue (frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
firebase_service_account.json
# Ignorar cachés globales
.cache/
.mypy_cache/
.pytest_cache/

## Environment files (never commit real secrets)
# Generic patterns
*.env
.env*

# Backend explicit
backend/.env
backend/.env.*
backend/*.env
!backend/.env.example

# Frontend explicit
frontend/.env
frontend/.env.*
frontend/*.env
!frontend/.env.example

# Allow sample files if needed (add them explicitly with ! pattern)

# Ignorar archivos de Alembic autogenerados
backend/alembic/versions/*.pyc

